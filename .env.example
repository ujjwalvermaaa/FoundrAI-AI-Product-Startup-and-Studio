# ============================================================
# FoundrAI — Environment Variables Template
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains secrets!
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ── Database (PostgreSQL) ─────────────────────────────────────
# Used by Docker Compose to create the database container.
# For local dev, set DATABASE_URL in backend/.env pointing to localhost:5432
POSTGRES_USER=foundrai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=foundrai

# Full async connection URL (used by the backend directly)
# In Docker: host is 'postgres' (the service name). In local dev: use 'localhost'
DATABASE_URL=postgresql+asyncpg://foundrai:CHANGE_ME_STRONG_PASSWORD@postgres:5432/foundrai

# ── JWT Authentication ────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Ollama (AI Inference) ─────────────────────────────────────
# Ollama runs on the HOST machine (outside Docker).
# Docker containers reach it via host.docker.internal.
# For local dev (no Docker), use: OLLAMA_BASE_URL=http://localhost:11434
# Pull the model first: ollama pull qwen3:4b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b

# ── Embeddings ────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── FAISS Vector Store ────────────────────────────────────────
FAISS_INDEX_PATH=./data/faiss

# ── RAG Configuration ─────────────────────────────────────────
RAG_TOP_K=8
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# ── LLM Defaults ─────────────────────────────────────────────
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_MAX_TOKENS=4096

# ── Storage Paths ─────────────────────────────────────────────
EXPORT_DIR=./data/exports
UPLOAD_DIR=./data/uploads
KNOWLEDGE_DIR=./data/knowledge
LOG_DIR=./logs

# ── Frontend ──────────────────────────────────────────────────
# URL visible to the browser (via nginx proxy in Docker).
# For local dev, set NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1 in Frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# ── Networking (Docker) ───────────────────────────────────────
# Port exposed by nginx on the host
HTTP_PORT=80

# ── Backend Workers ──────────────────────────────────────────
BACKEND_WORKERS=2

# ── Feature Flags ─────────────────────────────────────────────
ENABLE_RAG=true
ENABLE_MEMORY=true
ENABLE_REFLECTION=true
ENABLE_REPAIR=true
ENABLE_STREAMING=false
ENABLE_EXPORT=true
