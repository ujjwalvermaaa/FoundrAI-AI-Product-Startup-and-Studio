# ============================================================
# FoundrAI Frontend — Multi-stage Docker build
# Uses Bun as package manager (NOT pnpm/npm)
# Directory: Frontend/ (capital F — legacy name kept as-is)
# ============================================================

# ── Stage 1: Dependencies ────────────────────────────────────
FROM oven/bun:1.1-alpine AS deps

WORKDIR /app

# Copy lockfile and package manifest first (layer cache)
COPY Frontend/package.json Frontend/bun.lock* ./

# Install all dependencies (frozen for reproducibility)
RUN bun install --frozen-lockfile

# ── Stage 2: Builder ─────────────────────────────────────────
FROM oven/bun:1.1-alpine AS builder

WORKDIR /app

# Copy installed node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy full frontend source
COPY Frontend .

# Build-time API URL — override at docker build time with:
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://your-api.example.com
ARG NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Build Next.js in standalone mode (next.config.ts sets output: 'standalone')
RUN bun run build

# ── Stage 3: Production runner ───────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Non-root user for security
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# Standalone build copies everything needed into .next/standalone
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:3000/api/health || exit 1

CMD ["node", "server.js"]
