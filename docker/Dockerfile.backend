# ============================================================
# FoundrAI Backend — Multi-stage Docker build
# Python 3.12 + FastAPI + Poetry 2.x
# ============================================================

# ── Stage 1: Builder (installs deps) ─────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

# System build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Pin Poetry version to match dev environment
ENV POETRY_VERSION=2.4.1
ENV POETRY_HOME=/opt/poetry
ENV POETRY_VENV=/opt/poetry-venv
ENV POETRY_CACHE_DIR=/opt/.cache

# Install Poetry in an isolated venv
RUN python3 -m venv $POETRY_VENV \
    && $POETRY_VENV/bin/pip install --upgrade pip \
    && $POETRY_VENV/bin/pip install poetry==${POETRY_VERSION}

ENV PATH="${POETRY_VENV}/bin:${PATH}"

# Copy dependency files only (for layer caching)
COPY backend/pyproject.toml backend/poetry.lock* ./

# Install project dependencies (no dev deps, no root package)
RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --only main --no-root

# ── Stage 2: Runtime ─────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

# Runtime system deps only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Non-root user
RUN groupadd -r foundrai && useradd -r -g foundrai foundrai

# Copy application code
# Backend app
COPY backend/app ./app
# Alembic migrations
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
# AI package (included via pyproject.toml packages config)
COPY ai ./ai

# Data directories (will be mounted as volumes in production)
RUN mkdir -p /app/data/faiss /app/data/exports /app/data/uploads /app/data/knowledge /app/logs \
    && chown -R foundrai:foundrai /app

USER foundrai

EXPOSE 8000

# Use wget for healthcheck (more minimal than curl)
HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
    CMD wget -qO- http://localhost:8000/health || exit 1

# Run with 2 workers; adjust via WORKERS env var
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${WORKERS:-2}"]
