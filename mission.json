          "Workflow runs/steps/executions tables",
          "Agent 1: Idea Validation",
          "Agent 2: Market Research",
          "Agent 3: Business Model",
          "Agent 4: Product Strategy",
          "Agent 5: Technical Architecture",
          "Agent 6: Financial Planning",
          "Agent 7: Marketing Strategy",
          "Agent 8: Investor Documentation",
