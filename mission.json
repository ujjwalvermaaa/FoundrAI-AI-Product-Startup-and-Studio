  "tech_stack": {
    "frontend": {
      "framework": "Next.js 15",
      "ui_library": "React 19",
      "language": "TypeScript 5",
      "styling": "Tailwind CSS 4",
      "components": "shadcn/ui",
      "state_management": "TanStack Query 5",
      "animations": "Framer Motion 11",
      "validation": "Zod 3"
    },
    "backend": {
      "language": "Python 3.12",
      "framework": "FastAPI 0.115+",
      "server": "Uvicorn 0.32+",
      "orm": "SQLAlchemy 2.x",
      "migrations": "Alembic 1.14+",
      "validation": "Pydantic 2.x",
      "auth": "python-jose/PyJWT",
      "password": "passlib + bcrypt",
      "http_client": "httpx"
    },
    "ai": {
      "orchestration": "LangGraph 0.2+",
      "llm_framework": "LangChain 0.3+",
      "model_server": "Ollama",
      "primary_model": "Qwen 3 8B",
      "embeddings": "Sentence Transformers (BAAI/bge-base-en-v1.5)",
      "vector_store": "FAISS (CPU)"
    },
    "database": {
      "primary": "PostgreSQL 16",
      "vector_index": "FAISS"
    },
    "deployment": {
      "containerization": "Docker 27+",
      "orchestration": "Docker Compose v2"
    }
  },
  "excluded_technologies": {
    "note": "Do NOT use these - project runs completely locally",
    "cloud_llm_apis": ["OpenAI API", "Anthropic API", "Gemini API", "AWS Bedrock", "Azure OpenAI"],
    "cloud_services": ["Supabase", "Firebase", "Pinecone", "Chroma Cloud", "Redis Cloud"],
    "alternative_databases": ["MongoDB"]
  },
  "development_philosophy": {
    "principles": [
      "Production-quality code from day one",
      "Follow SOLID principles",
      "Use Clean Architecture",
      "Repository Pattern for data access",
      "Service Layer for business logic",
      "Dependency Injection where appropriate",
      "Modular and maintainable code",
      "Avoid tight coupling",
      "No code duplication",
      "Never hardcode secrets",
      "Comprehensive error handling",
      "Structured logging",
      "Type safety everywhere"
    ],
    "rules": {
      "always": [
        "Write clean, readable code",
        "Use type hints (Python) and TypeScript",
        "Write proper docstrings",
        "Use async where beneficial",
        "Use structured exceptions",
        "Use environment variables for config",
        "Write unit tests",
        "Write integration tests",
        "Follow documentation exactly"
      ],
      "never": [
        "Hardcode credentials",
        "Duplicate code",
        "Mix business logic in UI",
        "Skip validation",
        "Ignore error handling",
        "Commit secrets",
        "Deviate from architecture without approval"
      ]
    }
  },
  "success_criteria": {
    "functional": [
      "User can register, login, and manage profile",
      "User can create and manage projects",
      "User can trigger workflows for all 8 modules",
      "AI generates valid, structured artifacts",
      "Artifacts are versioned and editable",
      "Module dependencies are enforced",
      "Memory/RAG retrieves relevant context",
      "Investor pack export generates markdown bundle",
      "All features work via Docker Compose"
    ],
    "quality": [
      "Schema-valid outputs ≥85% before repair",
      "Workflow p95 latency <10 minutes",
      "API p95 latency <300ms (non-AI endpoints)",
      "Memory search <1s p95",
      "No secrets in logs",
      "100% of endpoints use proper auth",
      "All migrations are reversible"
    ],
    "operational": [
      "Clean Docker Compose startup",
      "Health checks pass",
      "Structured JSON logs",
      "Correlation IDs in workflow traces",
      "Readiness probes verify DB + Ollama"
    ]
  }
}
