{
  "project": {
    "name": "FoundrAI",
    "tagline": "From Idea to Startup, Powered by AI",
    "version": "1.0.0",
    "description": "AI-powered SaaS platform that helps entrepreneurs transform startup ideas into validated business plans, product roadmaps, technical architectures, financial strategies, marketing plans, and investor-ready documentation"
  },
  "architecture": {
    "frontend": {
      "technology": "Next.js 15, React 19, TypeScript, Tailwind CSS, shadcn/ui, TanStack Query, Framer Motion",
      "structure": "App Router with (auth) and (dashboard) route groups",
      "status": "partially_complete"
    },
    "backend": {
      "technology": "Python 3.12, FastAPI, SQLAlchemy, Alembic, PostgreSQL, JWT",
      "structure": "Clean Architecture with Repository Pattern and Service Layer",
      "status": "not_started"
    },
    "ai": {
      "technology": "LangGraph, LangChain, Ollama (Qwen 3 8B), Sentence Transformers, FAISS",
      "structure": "Multi-agent system with 8 specialized agents and workflow orchestration",
      "status": "not_started"
    },
    "deployment": {
      "technology": "Docker, Docker Compose",
      "environment": "Local-first with containerization",
      "status": "not_started"
    }
  },
  "pipeline": {
    "phases": [
      {
        "phase": 0,
        "name": "Foundation",
        "goal": "Setup repository structure, environment, CI/CD, health checks",
