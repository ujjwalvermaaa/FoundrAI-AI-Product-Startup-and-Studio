      },
      {
        "phase": 1,
        "name": "Core Platform",
        "goal": "Authentication, users, projects, database foundation",
        "status": "pending",
        "tasks": [
          "PostgreSQL setup and connection",
          "Alembic migrations initialization",
          "User model and authentication (JWT)",
          "Register/Login/Refresh/Logout endpoints",
          "Project CRUD endpoints",
          "Frontend authentication pages",
          "Frontend project management UI"
        ]
      },
      {
        "phase": 2,
        "name": "Workspace",
        "goal": "Module system, artifacts, versioning",
        "status": "pending",
        "tasks": [
          "Project modules seeding (8 modules)",
          "Module status management",
          "Artifacts and artifact_versions tables",
          "Artifact CRUD endpoints",
          "Module workspace UI",
          "Artifact viewer and editor components",
          "Version history UI"
        ]
      },
      {
        "phase": 3,
        "name": "AI Infrastructure",
        "goal": "Embeddings, memory, FAISS, knowledge base",
        "status": "pending",
        "tasks": [
          "Ollama setup and model pulling (Qwen 3 8B)",
